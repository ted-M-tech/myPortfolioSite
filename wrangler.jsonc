{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maepace-site",
  "compatibility_date": "2026-07-19",
  "account_id": "76b7441b99478c7d2bb1accbee256299",

  // Payment APIs only; all pages remain static Astro assets.
  "main": "server/payments.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/payments/*"],
    "not_found_handling": "404-page"
  },

  // apex を正とする。www → apex の 301 は Cloudflare の Redirect Rule 側で処理する
  // （Worker が無いのでコードでは扱えない。README のデプロイ節を参照）。
  "routes": [{ "pattern": "maepace.com", "custom_domain": true }],

  "observability": {
    "enabled": true
  }
}
