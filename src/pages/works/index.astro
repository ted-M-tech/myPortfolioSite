---
import Works from '../../layouts/Works.astro';
import WorkGallery from '../../components/WorkGallery.astro';
import {openWorks as c} from '../../data/profile';
---
<Works title="作品集 / Creative works — MaePace" description={c.description.ja}><div class="wrap"><div class="gallery-heading"><h1><span class="ja">{c.title.ja}</span><span class="en">{c.title.en}</span></h1><p><span class="ja">{c.description.ja}</span><span class="en">{c.description.en}</span></p></div><WorkGallery/></div></Works>
<style>.gallery-heading{padding-block:32px 24px}.gallery-heading h1{font-size:clamp(28px,3vw,40px);font-weight:550;line-height:1.3;letter-spacing:-.035em;text-wrap:balance}.gallery-heading p{font-size:15px;line-height:1.9;color:var(--text-muted);margin-top:12px;max-width:64ch}@media(max-width:620px){.gallery-heading{padding-block:24px 20px}.gallery-heading h1{font-size:28px}.gallery-heading p{font-size:13px}}</style>
