---
import Works from '../../layouts/Works.astro';
import WorkGallery from '../../components/WorkGallery.astro';
import {openWorks as c} from '../../data/profile';
---
<Works title="作品集 / Creative works — MaePace" description={c.description.ja}><div class="wrap"><div class="gallery-heading"><h1><span class="ja">{c.heading.ja}</span><span class="en">{c.heading.en}</span></h1><p><span class="ja">{c.description.ja}</span><span class="en">{c.description.en}</span></p></div><WorkGallery/></div></Works>
<style>.gallery-heading{padding-block:64px 42px}.gallery-heading h1{font-size:clamp(32px,4.4vw,64px);font-weight:550;line-height:1.3;letter-spacing:-.035em;text-wrap:balance}.gallery-heading p{font-size:15px;line-height:1.9;color:var(--text-muted);margin-top:20px;max-width:64ch}@media(max-width:620px){.gallery-heading{padding-block:40px 30px}.gallery-heading h1{font-size:34px}.gallery-heading p{font-size:13px}}</style>
