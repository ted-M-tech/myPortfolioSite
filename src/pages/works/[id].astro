---
import Works from '../../layouts/Works.astro';
import {openWorks as c} from '../../data/profile';
export function getStaticPaths(){return c.items.map(item=>({params:{id:item.id},props:{item}}));}
const {item}=Astro.props;
const docs=item.kind==='LP'?['PROMPTS.md','SKILLS.md','CREDITS.md']:['PROMPT.md','README.md','CREDITS.md'];
---
<Works title={`${item.title.ja} — MaePace`} description={item.description.ja}><article class="wrap work-detail"><a class="back" href="/works"><span aria-hidden="true">←</span> <span class="ja">{c.back.ja}</span><span class="en">{c.back.en}</span></a><div class="detail-heading"><div><h1><span class="ja">{item.title.ja}</span><span class="en">{item.title.en}</span></h1><p><span class="ja">{item.description.ja}</span><span class="en">{item.description.en}</span></p></div><a class="open-artifact" href={item.kind==='FILM'?'#artifact':item.live}><span class="ja">{c.view.ja}</span><span class="en">{c.view.en}</span><span aria-hidden="true">↗</span></a></div><div class:list={["artifact-stage", {portrait:item.kind==='FILM' && 'portrait' in item && item.portrait}]} id="artifact">{item.kind==='FILM'?<video controls playsinline preload="metadata" poster={item.image} src={item.live} aria-label={item.title.ja}/>:<a href={item.live}><img src={item.image} alt={item.title.ja} width="1440" height="960" fetchpriority="high"/></a>}</div><div class="detail-tools"><span>{item.tags.join(' / ')}</span><a href="#making"><span class="ja">{c.make.ja}</span><span class="en">{c.make.en}</span> ↓</a></div><section class="making" id="making"><div><h2><span class="ja">{c.make.ja}</span><span class="en">{c.make.en}</span></h2><p><span class="ja">{item.summary.ja}</span><span class="en">{item.summary.en}</span></p>{item.decisions && <div class="design-decisions"><h3><span class="ja">{c.decisions.ja}</span><span class="en">{c.decisions.en}</span></h3><ul>{item.decisions.map(decision=><li><span class="ja">{decision.ja}</span><span class="en">{decision.en}</span></li>)}</ul></div>}<div class="skill-line"><span class="ja">{c.skills.ja}</span><span class="en">{c.skills.en}</span><strong>{item.skills.join(' / ')}</strong></div><a class="source-action" href={item.source}><span class="ja">{c.source.ja}</span><span class="en">{c.source.en}</span> ↗</a><p class="claim-note"><span class="ja">{item.note.ja}</span><span class="en">{item.note.en}</span></p></div><div class="recipe"><h3><span class="ja">{c.prompts.ja}</span><span class="en">{c.prompts.en}</span></h3><p><span class="ja">{c.promptNote.ja}</span><span class="en">{c.promptNote.en}</span></p><pre class="prompt-body"><span class="ja">{item.prompt.ja}</span><span class="en">{item.prompt.en}</span></pre><button class="copy-prompt" data-copy-ja={item.prompt.ja} data-copy-en={item.prompt.en} data-label-ja={c.copy.ja} data-label-en={c.copy.en} data-copied-ja={c.copied.ja} data-copied-en={c.copied.en} data-error-ja={c.copyError.ja} data-error-en={c.copyError.en}><span class="ja">{c.copy.ja}</span><span class="en">{c.copy.en}</span></button><span class="copy-status" role="status"></span><div class="resource-links">{docs.map((file,i)=><a href={`${item.source}/${file}`}><span class="ja">{[c.prompts,c.skills,c.credits][i].ja}</span><span class="en">{[c.prompts,c.skills,c.credits][i].en}</span> ↗</a>)}</div></div></section></article></Works>
<script>document.querySelectorAll<HTMLButtonElement>('.copy-prompt').forEach(button=>button.addEventListener('click',async()=>{const en=document.documentElement.dataset.lang==='en';const status=button.nextElementSibling!;try{await navigator.clipboard.writeText((en?button.dataset.copyEn:button.dataset.copyJa)||'');status.textContent=(en?button.dataset.copiedEn:button.dataset.copiedJa)||'';}catch{status.textContent=(en?button.dataset.errorEn:button.dataset.errorJa)||'';}}));</script>
<style>.artifact-stage.portrait{background:#171818}.artifact-stage.portrait video{max-height:80svh;object-fit:contain}.design-decisions{margin-top:28px}.design-decisions h3{font-size:17px;font-weight:550}.design-decisions ul{padding-left:20px;margin-top:14px}.design-decisions li{font-size:14px;line-height:1.9;margin-bottom:12px;color:var(--text-muted)}.detail-heading h1>.ja{word-break:normal;overflow-wrap:normal}.work-detail{padding-top:34px}.back{font-size:13px;color:var(--text-muted)}.detail-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:34px 0}.detail-heading h1{word-break:normal;overflow-wrap:normal;font-size:clamp(28px,3.3vw,46px);font-weight:550;letter-spacing:-.03em;line-height:1.45;text-wrap:balance}.detail-heading p{font-size:14px;line-height:1.8;color:var(--text-muted);margin-top:12px}.open-artifact{display:flex;gap:22px;align-items:center;flex:none;padding:14px 20px;background:var(--ink);color:var(--paper);font-size:13px;border-radius:8px}.artifact-stage{background:var(--surface-sunken);border-radius:14px;overflow:hidden;border:1px solid var(--line)}.artifact-stage img,.artifact-stage video{display:block;width:100%;height:auto;max-height:none;object-fit:contain}.artifact-stage img{object-position:top;object-fit:cover}.detail-tools{display:flex;justify-content:space-between;gap:20px;font-size:12px;color:var(--text-muted);padding:22px 0 50px}.detail-tools a{color:var(--text)}.making{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line-strong);padding-top:50px;scroll-margin-top:100px}.making h2{font-size:30px;font-weight:550;letter-spacing:-.025em}.making p{font-size:14px;line-height:2;color:var(--text-muted);margin-top:18px;max-width:65ch}.skill-line{display:flex;gap:20px;flex-wrap:wrap;font-size:12px;margin:26px 0}.skill-line strong{font-weight:500}.source-action{display:inline-block;padding-bottom:8px;border-bottom:1px solid var(--line-strong);font-size:14px}.making .claim-note{font-size:11px;margin-top:28px}.recipe{background:var(--surface-sunken);padding:30px;border-radius:12px}.recipe h3{font-size:20px;font-weight:550}.recipe p{font-size:12px;margin-top:12px}.prompt-body{font:inherit;font-size:14px;white-space:pre-wrap;line-height:2;margin:24px 0;overflow-wrap:anywhere}.copy-prompt{border:1px solid var(--line-strong);padding:9px 14px;background:var(--paper);font:inherit;font-size:12px;border-radius:6px;cursor:pointer}.copy-status{display:block;font-size:12px;margin-top:10px}.resource-links{display:flex;gap:20px;flex-wrap:wrap;margin-top:24px;font-size:12px}@media(max-width:800px){.making{grid-template-columns:1fr;gap:32px}.detail-heading{display:block}.open-artifact{display:inline-flex;margin-top:20px}.detail-tools{flex-wrap:wrap;padding-bottom:32px}.recipe{padding:24px}.detail-heading h1{word-break:normal;overflow-wrap:normal;font-size:29px}.artifact-stage{border-radius:8px}.making{padding-top:32px}.making h2{font-size:25px}}</style>
