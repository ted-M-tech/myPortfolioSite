---
import {siteNavigation} from '../data/profile';
import NoteArticles from './NoteArticles.astro';
const content=siteNavigation.homeLearning;
---
<section class="home-content home-blog" id="blog" aria-labelledby="home-blog-heading">
  <div class="wrap">
    <header><div><h2 id="home-blog-heading"><span class="ja">{content.blog.title.ja}</span><span class="en">{content.blog.title.en}</span></h2><p><span class="ja">{content.blog.description.ja}</span><span class="en">{content.blog.description.en}</span></p></div><a href="/learn/blog"><span class="ja">{content.blog.action.ja}</span><span class="en">{content.blog.action.en}</span> →</a></header>
    <NoteArticles limit={3} compact />
  </div>
</section>
<style>
.home-content{padding-block:60px;border-top:1px solid var(--line)}
header{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:24px}
h2{font-size:clamp(28px,3vw,38px);font-weight:600;letter-spacing:-.035em;line-height:1.3}
header p{font-size:14px;line-height:1.8;color:var(--text-muted);margin-top:12px}header>a{flex:none;font-size:13px;font-weight:500}
header>a:hover{text-decoration:underline;text-underline-offset:5px}
@media(max-width:600px){.home-content{padding-block:40px}header{align-items:flex-start;flex-wrap:wrap;gap:16px}header p{font-size:13px}}
</style>
