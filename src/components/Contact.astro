---
import { person, socials, contact } from "../data/profile";
import BookingCalendar from "./BookingCalendar.astro";
import Icon from "./Icon.astro";


---

<section class="consultation" id="consultation">
 <div class="wrap">
  <header><p class="eyebrow"><span class="ja">{contact.detail.ja}</span><span class="en">{contact.detail.en}</span></p>
  <h2><span class="ja">{contact.title.ja}</span><span class="en">{contact.title.en}</span></h2>
  <p><span class="ja">{contact.description.ja}</span><span class="en">{contact.description.en}</span></p></header>
  <p class="calendar-hint"><span class="ja">{contact.hint.ja}</span><span class="en">{contact.hint.en}</span> <a href="/learn/privacy"><span class="ja">{contact.privacy.ja}</span><span class="en">{contact.privacy.en}</span> ↗</a></p>
  <BookingCalendar />
 </div>
</section>
<section class="contact on-dark" id="contact">
  <div class="wrap reveal">
    <p class="eyebrow">Contact</p>

    <a class="mail" href={`mailto:${person.email}`}>{person.email}</a>

    <ul class="socials">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

</section>

<style>
.consultation{padding-block:64px;border-top:1px solid var(--line)}.consultation header{max-width:760px;margin-bottom:28px}.consultation h2{font-size:clamp(27px,3vw,40px);font-weight:600;line-height:1.4;letter-spacing:-.035em;margin:14px 0}.consultation header>p:last-child{font-size:15px;line-height:1.9;color:var(--text-muted)}.calendar-hint{font-size:12px;line-height:1.8;color:var(--text-muted);margin-bottom:20px}.calendar-hint a{text-decoration:underline;text-underline-offset:3px}@media(max-width:600px){.consultation{padding-block:40px}}

  .contact {
    background: var(--surface-dark);
    color: var(--text-on-dark);
    text-align: center;
    /* 見出しと説明文を落として中身が短くなったので、上下の余白も詰める */
    padding-block: clamp(72px, 9vw, 116px) 32px;
  }

  .mail {
    display: inline-block;
    margin-top: 18px;
    font-size: clamp(17px, 2.4vw, 27px);
    font-weight: 500;
    border-bottom: 1px solid var(--line-on-dark);
    padding-bottom: 4px;
    transition: border-color var(--dur-fast);
    word-break: break-all;
  }

  .mail:hover {
    border-bottom-color: var(--paper-inv);
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 44px;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-on-dark);
    color: var(--text-on-dark-muted);
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast),
      transform var(--dur-fast) var(--ease-out);
  }

  .socials a:hover {
    color: var(--text-on-dark);
    border-color: var(--paper-inv);
    transform: translateY(-3px);
  }

</style>
