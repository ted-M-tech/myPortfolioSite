---
interface Props {title:string;english:string;description?:string}
const {title,english,description}=Astro.props;
---
<header class="page-heading wrap"><h1>{title}<span class="ja"> / {english}</span></h1>{description&&<p>{description}</p>}</header>
<style>
.page-heading{padding-block:64px 36px;margin-bottom:32px;border-bottom:1px solid var(--line)}.page-heading h1{font-size:clamp(30px,4vw,48px);font-weight:600;line-height:1.35;letter-spacing:-.035em}.page-heading h1 span{font-size:.65em;font-weight:400;letter-spacing:-.02em;color:var(--text-muted)}.page-heading p{font-size:14px;color:var(--text-muted);margin:16px 0 0;line-height:1.8}@media(max-width:600px){.page-heading{padding-block:32px 24px;margin-bottom:24px}}
</style>
