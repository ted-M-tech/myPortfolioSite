---
import {openWorks as c} from '../data/profile';
---
<section class="open-works" id="open-works" aria-labelledby="works-title">
 <div class="wrap">
  <div class="works-heading"><h2 id="works-title"><span class="ja">{c.title.ja}</span><span class="en">{c.title.en}</span></h2><p><span class="ja">{c.description.ja}</span><span class="en">{c.description.en}</span></p></div>
  <a class="collection" href={c.href}>
   <div class="collection-device" aria-hidden="true"><div class="collection-screen">{c.items.map(item=><div class:list={['collection-tile',item.id, {portrait:'portrait' in item && item.portrait}]}><img src={item.image} alt="" width="1440" height="960" loading="lazy"/><span class="tile-label">{item.title.en.split(' — ')[0]} / {item.kind}</span></div>)}</div></div>
   <div class="collection-caption"><span class="collection-types">{c.overviewTypes}</span><span class="collection-action"><span class="ja">{c.action.ja}</span><span class="en">{c.action.en}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span></div>
  </a>
 </div>
</section>
<style>
.open-works{scroll-margin-top:120px;padding-block:var(--section-y);background:var(--paper);border-top:1px solid var(--line)}.works-heading{display:flex;align-items:baseline;justify-content:space-between;gap:30px;margin-bottom:32px}.works-heading h2{font-size:clamp(30px,4vw,54px);line-height:1.25;letter-spacing:-.03em;font-weight:550}.works-heading p{font-size:14px;color:var(--text-muted);line-height:1.8}.collection{display:block;color:var(--text);text-decoration:none}.collection-device{padding:14px;background:#171818;border:3px solid #c8c9c7;border-radius:34px;box-shadow:0 2px 0 #fff inset,0 18px 40px -28px #17181866;transition:transform .35s var(--ease-out)}.collection-screen{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:7px;aspect-ratio:1.65;overflow:hidden;border-radius:20px;background:#171818}.collection-tile{position:relative;overflow:hidden;min-width:0;min-height:0;background:var(--surface-sunken)}.collection-tile:first-child{grid-column:span 2}.collection-tile:last-child{grid-column:span 2}.collection-tile img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .5s var(--ease-out)}.collection-tile.portrait img{object-fit:contain}.collection-tile.portrait{background:#f7f5f2}.collection-tile.lanclo-film{background:#fbf7ec}.collection-tile.lanclo-film img{object-fit:contain}.collection-tile:first-child img{object-position:center 37%}.collection-tile.maepace-web img{object-position:center 65%}.tile-label{position:absolute;left:10px;bottom:10px;background:#171818cf;color:#fff;padding:4px 8px;border-radius:4px;font-size:10px;letter-spacing:.02em}.collection-caption{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:23px 4px 0}.collection-types{font-size:11px;letter-spacing:.12em;color:var(--text-muted)}.collection-action{display:flex;gap:20px;align-items:center;font-size:15px}.collection-action svg{width:22px;height:22px;transition:transform .25s}.collection:hover .collection-device{transform:translateY(-4px)}.collection:hover .collection-action svg{transform:translate(2px,-2px)}.collection:focus-visible{outline:2px solid var(--accent);outline-offset:8px;border-radius:30px}@media(max-width:650px){.works-heading{display:block;margin-bottom:24px}.works-heading p{margin-top:14px;font-size:13px}.collection-device{padding:7px;border-width:2px;border-radius:20px}.collection-screen{border-radius:11px;gap:4px;aspect-ratio:.8;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(6,minmax(0,1fr))}.collection-tile:first-child{grid-column:span 2}.collection-tile:last-child{grid-column:span 2}.tile-label{font-size:8px;left:5px;bottom:5px;padding:2px 5px}.collection-caption{padding-top:18px;gap:12px}.collection-types{font-size:8px;letter-spacing:.08em}.collection-action{font-size:12px;gap:10px}.collection-action svg{width:18px;height:18px}}@media(prefers-reduced-motion:reduce){.collection-device,.collection-tile img,.collection-action svg{transition:none}.collection:hover .collection-device{transform:none}}
</style>
