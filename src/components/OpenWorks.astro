---
import {openWorks as c} from '../data/profile';
// 量を見せる壁。作品と各話のポスターを全部並べ、件数から格子を決める。作品を足してもここは触らない。
type Tile={id:string;image:string;label?:string;portrait?:boolean};
const works:Tile[]=c.items.flatMap((item):Tile[]=>'episodes' in item&&item.episodes?.length
 ?item.episodes.map(e=>({id:e.id,image:e.image,portrait:true}))
 :[{id:item.id,image:item.image,label:`${item.title.en.split(' — ')[0]} / ${item.kind}`,portrait:'portrait' in item&&item.portrait}]);
// 枠の縦横比に対し、セルが縦長ポスターに近く(3:4)、空きマスが少ない列数を選ぶ。
const grid=(aspect:number)=>{let best={cols:1,rows:works.length,score:Infinity};for(let cols=2;cols<=14;cols++){const rows=Math.ceil(works.length/cols),score=Math.abs(Math.log(aspect*rows/cols/.75))+(rows*cols-works.length)/works.length;if(score<best.score)best={cols,rows,score};}return best;};
const wide=grid(1.65),narrow=grid(.8);
// 空きマスは先頭から繰り返して埋める。片方の格子にしか要らないマスは、もう片方で隠す。
const tiles=Array.from({length:Math.max(wide.cols*wide.rows,narrow.cols*narrow.rows)},(_,i)=>works[i%works.length]);
---
<section class="open-works" id="open-works" aria-labelledby="works-title">
 <div class="wrap">
  <div class="works-heading"><h2 id="works-title"><span class="ja">{c.title.ja}</span><span class="en">{c.title.en}</span></h2><p><span class="ja">{c.description.ja}</span><span class="en">{c.description.en}</span></p></div>
  <a class="collection" href={c.href}>
   <div class="collection-device" aria-hidden="true"><div class="collection-screen" style={`--cols:${wide.cols};--rows:${wide.rows};--cols-sm:${narrow.cols};--rows-sm:${narrow.rows}`}>{tiles.map((item,i)=><div class:list={['collection-tile',item.id,{portrait:item.portrait,'not-wide':i>=wide.cols*wide.rows,'not-narrow':i>=narrow.cols*narrow.rows}]}><img src={item.image} alt="" width="540" height="720" loading="lazy"/>{item.label&&<span class="tile-label">{item.label}</span>}</div>)}</div></div>
   <div class="collection-caption"><span class="collection-types">{c.overviewTypes}</span><span class="collection-action"><span class="ja">{c.action.ja}</span><span class="en">{c.action.en}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span></div>
  </a>
 </div>
</section>
<style>
.open-works{scroll-margin-top:120px;padding-block:var(--section-y);background:var(--paper);border-top:1px solid var(--line)}.works-heading{display:flex;align-items:baseline;justify-content:space-between;gap:30px;margin-bottom:32px}.works-heading h2{font-size:clamp(30px,4vw,54px);line-height:1.25;letter-spacing:-.03em;font-weight:550}.works-heading p{font-size:14px;color:var(--text-muted);line-height:1.8}.collection{display:block;color:var(--text);text-decoration:none}.collection-device{padding:14px;background:#171818;border:3px solid #c8c9c7;border-radius:34px;box-shadow:0 2px 0 #fff inset,0 18px 40px -28px #17181866;transition:transform .35s var(--ease-out)}.collection-screen{display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));grid-template-rows:repeat(var(--rows),minmax(0,1fr));gap:5px;aspect-ratio:1.65;overflow:hidden;border-radius:20px;background:#171818}.collection-tile{position:relative;overflow:hidden;min-width:0;min-height:0;background:var(--surface-sunken)}.collection-tile.not-wide{display:none}.collection-tile img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .5s var(--ease-out)}.collection-tile.portrait img{object-position:center top}.collection-tile.portrait{background:#f7f5f2}.collection-tile.maepace-web img{object-position:center 65%}.tile-label{position:absolute;left:5px;right:5px;bottom:5px;width:max-content;max-width:calc(100% - 10px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#171818cf;color:#fff;padding:2px 6px;border-radius:4px;font-size:9px;letter-spacing:.02em}.collection-caption{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:23px 4px 0}.collection-types{font-size:11px;letter-spacing:.12em;color:var(--text-muted)}.collection-action{display:flex;gap:20px;align-items:center;font-size:15px}.collection-action svg{width:22px;height:22px;transition:transform .25s}.collection:hover .collection-device{transform:translateY(-4px)}.collection:hover .collection-action svg{transform:translate(2px,-2px)}.collection:focus-visible{outline:2px solid var(--accent);outline-offset:8px;border-radius:30px}@media(max-width:650px){.works-heading{display:block;margin-bottom:24px}.works-heading p{margin-top:14px;font-size:13px}.collection-device{padding:7px;border-width:2px;border-radius:20px}.collection-screen{border-radius:11px;gap:3px;aspect-ratio:.8;grid-template-columns:repeat(var(--cols-sm),minmax(0,1fr));grid-template-rows:repeat(var(--rows-sm),minmax(0,1fr))}.tile-label{display:none}.collection-tile.not-wide{display:block}.collection-tile.not-narrow{display:none}.collection-caption{padding-top:18px;gap:12px}.collection-types{font-size:8px;letter-spacing:.08em}.collection-action{font-size:12px;gap:10px}.collection-action svg{width:18px;height:18px}}@media(prefers-reduced-motion:reduce){.collection-device,.collection-tile img,.collection-action svg{transition:none}.collection:hover .collection-device{transform:none}}
</style>
