---
import {openWorks as c} from '../data/profile';
import WorkGallery from './WorkGallery.astro';
---
<section class="open-works" id="open-works" aria-labelledby="works-title"><div class="wrap"><div class="works-heading"><div><h2 id="works-title"><span class="ja">{c.title.ja}</span><span class="en">{c.title.en}</span></h2><p><span class="ja">{c.description.ja}</span><span class="en">{c.description.en}</span></p></div><a href={c.href}><span class="ja">{c.action.ja}</span><span class="en">{c.action.en}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div><WorkGallery compact/></div></section>
<style>.open-works{scroll-margin-top:140px;padding-block:var(--section-y);background:var(--paper);border-top:1px solid var(--line)}.works-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:34px}.works-heading h2{font-size:clamp(30px,4vw,54px);line-height:1.25;letter-spacing:-.03em;font-weight:550}.works-heading p{font-size:14px;color:var(--text-muted);margin-top:15px;line-height:1.8}.works-heading>a{display:flex;gap:16px;align-items:center;flex:none;font-size:13px;padding-block:10px;border-bottom:1px solid var(--line-strong)}.works-heading svg{width:18px;height:18px}@media(max-width:650px){.works-heading{display:block}.works-heading>a{display:inline-flex;margin-top:16px}.works-heading p{font-size:13px}}</style>
