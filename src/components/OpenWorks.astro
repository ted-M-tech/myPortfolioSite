---
import {openWorks as c} from '../data/profile';
---
<section class="open-works" id="open-works" aria-labelledby="open-works-title">
 <div class="wrap open-heading"><div><h2 id="open-works-title"><span class="ja">{c.title.ja}</span><span class="en">{c.title.en}</span></h2><p><span class="ja">{c.description.ja}</span><span class="en">{c.description.en}</span></p></div><a href={c.href}><span class="ja">{c.action.ja}</span><span class="en">{c.action.en}</span> ↗</a></div>
 <div class="works-window"><div class="works-track">{[0,1].map(copy=><div class="works-set" aria-hidden={copy===1?'true':undefined}>{c.items.map(item=><a class="open-work" href={item.href} tabindex={copy===1?-1:undefined}><div class="work-preview"><img src={item.image} alt="" width="720" height="450" loading="lazy"/></div><div class="work-caption"><small>{item.kind}</small><h3><span class="ja">{item.title.ja}</span><span class="en">{item.title.en}</span></h3><p><span class="ja">{item.description.ja}</span><span class="en">{item.description.en}</span></p></div></a>)}</div>)}</div></div>
 <div class="wrap motion-row"><button type="button" class="works-pause" aria-pressed="false"><span class="pause"><span class="ja">{c.pause.ja}</span><span class="en">{c.pause.en}</span></span><span class="resume" hidden><span class="ja">{c.resume.ja}</span><span class="en">{c.resume.en}</span></span></button></div>
</section>
<style>
.open-works{padding-block:var(--section-y);background:var(--surface-sunken);overflow:clip}.open-heading{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:36px}.open-heading h2{font-size:clamp(30px,4vw,56px);line-height:1.3;letter-spacing:-.035em;font-weight:600;text-wrap:balance}.open-heading p{font-size:15px;line-height:1.8;max-width:52ch;color:var(--text-muted);margin-top:18px}.open-heading>a{font-size:13px;white-space:nowrap;border-bottom:1px solid var(--line-strong);padding-bottom:7px}.works-window{overflow:hidden}.works-track{display:flex;width:max-content;animation:works-drift 48s linear infinite}.works-set{display:flex;gap:28px;padding-right:28px}.open-work{display:block;width:clamp(300px,35vw,540px);flex:none;color:var(--text)}.work-preview{aspect-ratio:8/5;overflow:hidden;border-radius:14px;background:var(--surface-raised)}.work-preview img{display:block;width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .4s}.open-work:hover img{transform:scale(1.025)}.work-caption{padding:20px 4px 0}.work-caption small{font-size:10px;letter-spacing:.12em;color:var(--text-muted)}.work-caption h3{font-size:clamp(20px,2vw,27px);line-height:1.5;margin-top:8px;font-weight:550;letter-spacing:-.025em}.work-caption p{font-size:12px;color:var(--text-muted);margin-top:7px}.works-window:hover .works-track,.works-window:focus-within .works-track,.open-works[data-paused] .works-track{animation-play-state:paused}.motion-row{display:flex;justify-content:flex-end;margin-top:24px}.works-pause{font:inherit;font-size:11px;color:var(--text-muted);background:none;border:none;cursor:pointer;padding:8px}.open-work:focus-visible,.works-pause:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@keyframes works-drift{to{transform:translateX(-50%)}}@media(max-width:720px){.open-heading{display:block}.open-heading>a{display:inline-block;margin-top:20px}.open-heading p{font-size:13px}.works-set{gap:18px;padding-right:18px}.works-track{animation-duration:42s}.open-work{width:300px}}@media(prefers-reduced-motion:reduce){.works-window{overflow-x:auto}.works-track{animation:none}.works-set[aria-hidden]{display:none}.motion-row{display:none}}
</style>
<script>
const section=document.querySelector<HTMLElement>('.open-works');
const button=section?.querySelector<HTMLButtonElement>('.works-pause');
button?.addEventListener('click',()=>{const paused=section!.toggleAttribute('data-paused');button.setAttribute('aria-pressed',String(paused));button.querySelector<HTMLElement>('.pause')!.hidden=paused;button.querySelector<HTMLElement>('.resume')!.hidden=!paused;});
</script>
