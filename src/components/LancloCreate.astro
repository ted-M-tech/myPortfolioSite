---
import {lancloCreate as c} from '../data/profile';
const demo = `${import.meta.env.PUBLIC_WORKS_DEMO_ORIGIN || 'https://videos.maepace.com'}/demos/lanclo-lp/`;
---
<section class="create-work" aria-labelledby="create-title">
 <div class="create-heading"><span>LP / WEB</span><h1 id="create-title"><span class="ja">{c.title.ja}</span><span class="en">{c.title.en}</span></h1><p><span class="ja">{c.intro.ja}</span><span class="en">{c.intro.en}</span></p></div>
 <div class="create-layout">
  <div class="preview-shell">
   <div class="preview-toolbar"><span class="preview-label"><span class="ja">{c.preview.ja}</span><span class="en">{c.preview.en}</span></span><div role="group" aria-label="Preview width"><button data-preview-size="desktop" aria-pressed="true"><span class="ja">{c.desktop.ja}</span><span class="en">{c.desktop.en}</span></button><button data-preview-size="mobile" aria-pressed="false"><span class="ja">{c.mobile.ja}</span><span class="en">{c.mobile.en}</span></button></div><a href={demo} target="_blank" rel="noopener"><span class="ja">{c.open.ja}</span><span class="en">{c.open.en}</span> ↗</a></div>
   <div class="preview-canvas"><div class="preview-viewport" data-size="desktop"><iframe src={`${demo}?lang=ja`} data-demo-url={demo} title="Lanclo landing page — interactive preview" loading="eager" sandbox="allow-scripts allow-same-origin allow-popups" referrerpolicy="no-referrer"></iframe></div></div>
  </div>
  <aside class="create-recipe"><div class="recipe-name">Lanclo</div><h2><span class="ja">{c.heading.ja}</span><span class="en">{c.heading.en}</span></h2><p><span class="ja">{c.body.ja}</span><span class="en">{c.body.en}</span></p><button class="create-copy" data-ja={c.prompt.ja} data-en={c.prompt.en} data-copied-ja={c.copied.ja} data-copied-en={c.copied.en} data-error-ja={c.error.ja} data-error-en={c.error.en}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3"/></svg><span class="ja">{c.copy.ja}</span><span class="en">{c.copy.en}</span></button><span class="create-status" role="status" aria-live="polite"></span>
   <details class="create-prompt"><summary><span class="ja">{c.expand.ja}</span><span class="en">{c.expand.en}</span></summary><pre tabindex="0"><span class="ja">{c.prompt.ja}</span><span class="en">{c.prompt.en}</span></pre></details>
   <h3><span class="ja">{c.kit.ja}</span><span class="en">{c.kit.en}</span></h3><ul>{c.includes.ja.map((x,i)=><li><span aria-hidden="true">✓</span><span class="ja">{x}</span><span class="en">{c.includes.en[i]}</span></li>)}</ul><p class="requirements"><span class="ja">{c.requirements.ja}</span><span class="en">{c.requirements.en}</span></p><a class="kit-link" href={c.sourceUrl}><span class="ja">{c.source.ja}</span><span class="en">{c.source.en}</span> ↗</a><a class="kit-link" href={c.skillsUrl}><span class="ja">{c.skills.ja}</span><span class="en">{c.skills.en}</span> ↗</a><p class="create-note"><span class="ja">{c.note.ja}</span><span class="en">{c.note.en}</span></p>
  </aside>
 </div>
</section>
<script>
const viewport=document.querySelector<HTMLElement>('.preview-viewport');
const canvas=document.querySelector<HTMLElement>('.preview-canvas');
const frame=viewport?.querySelector('iframe');
function fit(){if(!viewport||!canvas||!frame)return;const width=viewport.dataset.size==='mobile'?390:1440;const scale=Math.min(canvas.clientWidth/width,1);viewport.style.width=`${width*scale}px`;frame.style.width=`${width}px`;frame.style.height=`${canvas.clientHeight/scale}px`;frame.style.transform=`scale(${scale})`;}
if(viewport && window.innerWidth<=760){viewport.dataset.size='mobile';document.querySelectorAll<HTMLElement>('[data-preview-size]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.previewSize==='mobile')));}
if(canvas)new ResizeObserver(fit).observe(canvas);
document.querySelectorAll<HTMLButtonElement>('[data-preview-size]').forEach(button=>button.addEventListener('click',()=>{if(!viewport)return;viewport.dataset.size=button.dataset.previewSize;document.querySelectorAll('[data-preview-size]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));fit();}));
function syncLanguage(){if(!frame)return;frame.src=frame.dataset.demoUrl+'?lang='+(document.documentElement.dataset.lang==='en'?'en':'ja');}
syncLanguage();document.addEventListener('maepace:language',syncLanguage);
const copy=document.querySelector<HTMLButtonElement>('.create-copy');copy?.addEventListener('click',async()=>{const en=document.documentElement.dataset.lang==='en';const status=document.querySelector('.create-status')!;try{await navigator.clipboard.writeText((en?copy.dataset.en:copy.dataset.ja)||'');status.textContent=(en?copy.dataset.copiedEn:copy.dataset.copiedJa)||'';}catch{status.textContent=(en?copy.dataset.errorEn:copy.dataset.errorJa)||'';document.querySelector('details.create-prompt')?.setAttribute('open','');}});
</script>
<style>
.create-heading{padding:28px 0 30px}.create-heading>span,.recipe-name{font-size:12px;color:var(--text-muted)}.create-heading h1{font-size:clamp(30px,3.5vw,48px);font-weight:550;letter-spacing:-.035em;margin:12px 0}.create-heading p{font-size:15px;color:var(--text-muted);line-height:1.9}.create-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:28px;align-items:start}.preview-shell{border:1px solid var(--line-strong);border-radius:12px;overflow:hidden;background:#fff;min-width:0;position:sticky;top:100px}.preview-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;font-size:11px;border-bottom:1px solid var(--line)}.preview-toolbar div{display:flex;gap:3px}.preview-toolbar button{font:inherit;padding:7px 10px;border:0;border-radius:5px;background:transparent;cursor:pointer}.preview-toolbar button[aria-pressed=true]{background:var(--ink);color:var(--paper)}.preview-toolbar a{white-space:nowrap}.preview-canvas{height:min(650px,72svh);min-height:400px;background:#e5e3df;display:flex;justify-content:center;overflow:hidden}.preview-viewport{height:100%;flex-shrink:0;position:relative;background:white}.preview-viewport iframe{border:0;display:block;transform-origin:top left;max-width:none}.create-recipe{padding:24px;background:var(--surface-raised);border:1px solid var(--line);border-radius:12px;min-width:0}.create-recipe h2{font-size:24px;font-weight:550;margin:10px 0 14px}.create-recipe p{font-size:13px;line-height:1.9;color:var(--text-muted)}.create-copy{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:15px 8px;margin-top:22px;background:var(--ink);color:var(--paper);border:0;border-radius:7px;font:inherit;font-size:13px;cursor:pointer}.create-status{display:block;font-size:11px;line-height:1.6;margin-top:8px}.create-prompt{margin-top:16px;font-size:12px}.create-prompt summary{cursor:pointer;text-decoration:underline;text-underline-offset:4px}.create-prompt pre{font:inherit;line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere;max-height:400px;overflow:auto;margin-top:16px;padding:12px;background:var(--surface-sunken)}.create-recipe h3{font-size:13px;margin:28px 0 12px}.create-recipe ul{list-style:none;margin:0;padding:0}.create-recipe li{display:flex;gap:8px;font-size:12px;line-height:1.8;margin-bottom:8px}.create-recipe .requirements{font-size:11px;margin-top:18px}.kit-link{display:block;font-size:12px;margin-top:16px;text-decoration:underline;text-underline-offset:4px}.create-recipe .create-note{font-size:11px;margin-top:24px}.create-work button:focus-visible,.create-work a:focus-visible,.create-work summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
@media(max-width:1000px){.create-layout{grid-template-columns:minmax(0,1fr) 300px;gap:18px}.preview-label{display:none}}
@media(max-width:760px){.create-layout{grid-template-columns:1fr}.preview-shell{position:static}.create-heading{padding-top:24px}.preview-canvas{height:420px;min-height:0}.create-recipe{padding:22px}.preview-toolbar{font-size:12px}.create-heading p{font-size:14px}.create-copy{font-size:14px}.create-note{max-width:60ch}}
</style>
