---
import {openWorks as c} from '../data/profile';
const names:Record<string,{ja:string,en:string}>={
 'lanclo-lp':{ja:'Lanclo',en:'Lanclo'},'lanclo-film':{ja:'Lanclo — 自分の声で学ぶ',en:'Lanclo — Your daily English'},
 'tako-talk':{ja:'Tako Talk',en:'Tako Talk'},'maepace-web':{ja:'MaePace',en:'MaePace'},'annoscene':{ja:'AnnoScene',en:'AnnoScene'},
 'tako-stickers':{ja:'動く関西弁 — ループポスター',en:'Kansai reactions — Loop poster'},'tako-4280':{ja:'4,280円、言える？',en:'Can you say ¥4,280?'},
 'tokyo-osaka':{ja:'Tokyo vs Osaka',en:'Tokyo vs Osaka'},'kansai-talk':{ja:'中の人トーク',en:'Kansai listening challenge'},
 'tako-line-stickers':{ja:'たこ先生のLINEスタンプ',en:'Tako Sensei — LINE stickers'}
};
const filters=[{key:'all',label:c.all},{key:'LP',label:c.lp},{key:'FILM',label:c.film},{key:'STICKERS',label:{ja:'スタンプ',en:'Stickers'}}];
---
<div class="artifact-gallery" data-gallery>
 <div class="gallery-toolbar"><div class="gallery-filters" aria-label="Works">
 {filters.map((filter,i)=><button data-filter={filter.key} aria-pressed={i===0}><span class="ja">{filter.label.ja}</span><span class="en">{filter.label.en}</span><span class="count">{filter.key==='all'?c.items.length:c.items.filter(x=>x.kind===filter.key).length}</span></button>)}
 </div><span class="coming"><span class="ja">{c.future.ja}</span><span class="en">{c.future.en}</span></span></div>
 <div class="artifact-grid">{c.items.map(item=>{
 const title=names[item.id]||item.title;
 return <article class="artifact" data-kind={item.kind}>
 <a class="artifact-link" href={item.href}>
 <div class:list={['artifact-preview',{portrait:'portrait' in item&&item.portrait,film:item.kind==='FILM'}]}>
 <img src={item.image} alt="" width="960" height="600" loading="lazy"/>
 {item.kind==='FILM'&&<span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 5.5 19 12 9 18.5Z"/></svg></span>}
 </div>
 <div class="artifact-caption"><h2><span class="ja">{title.ja}</span><span class="en">{title.en}</span></h2><span class="kind">{item.kind==='LP'?'WEB':item.kind}</span></div>
 </a></article>;
 })}</div>
</div>
<style>
.gallery-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line-strong);padding-bottom:16px;margin-bottom:24px}.gallery-filters{display:flex;gap:4px;flex-wrap:wrap}.gallery-filters button{display:flex;align-items:center;gap:8px;min-height:44px;padding:8px 12px;border:0;border-radius:8px;background:none;color:var(--text-muted);font:inherit;font-size:13px;cursor:pointer}.gallery-filters button[aria-pressed=true]{background:var(--ink);color:var(--paper)}.count{font-size:11px;font-variant-numeric:tabular-nums}.coming{font-size:12px;color:var(--text-muted)}
.artifact-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 20px;align-items:start}.artifact{min-width:0}.artifact[hidden]{display:none}.artifact-link{display:block;text-decoration:none}.artifact-preview{position:relative;border-radius:12px;overflow:hidden;aspect-ratio:8/5;background:var(--surface-sunken);border:1px solid var(--line)}.artifact-preview img{width:100%;height:100%;object-fit:cover;object-position:top;display:block;transition:transform .3s var(--ease-out)}.artifact-preview.portrait{aspect-ratio:4/3;background:#e8e4dc}.artifact-preview.portrait img{object-fit:contain}.play-mark{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#171818e8;color:#fff;border:1px solid #ffffff70;transition:background .2s,transform .2s}.play-mark svg{width:25px;height:25px;fill:currentColor}.artifact-link:hover .play-mark{background:#171818;transform:translate(-50%,-50%) scale(1.08)}.artifact-link:hover img{transform:scale(1.025)}.artifact-caption{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-top:12px}.artifact-caption h2{font-size:15px;line-height:1.6;font-weight:550;letter-spacing:-.02em;overflow-wrap:anywhere}.kind{font-size:10px;letter-spacing:.04em;color:var(--text-muted);flex:none}.artifact-link:focus-visible,.gallery-filters button:focus-visible{outline:2px solid var(--accent);outline-offset:5px;border-radius:8px}
@media(max-width:1279px){.artifact-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:760px){.artifact-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 12px}.coming{display:none}.artifact-caption{display:block;margin-top:8px}.artifact-caption h2{font-size:13px;line-height:1.55}.kind{display:block;margin-top:4px;font-size:9px}.play-mark{width:40px;height:40px}.play-mark svg{width:22px;height:22px}.gallery-filters button{font-size:12px;padding:8px 10px;gap:5px}.gallery-filters{gap:0}.gallery-toolbar{margin-bottom:20px}.artifact-preview{border-radius:10px}}
@media(prefers-reduced-motion:reduce){.artifact-preview img,.play-mark{transition:none}}
</style>
<script>
document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(gallery=>{gallery.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{gallery.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));gallery.querySelectorAll<HTMLElement>('[data-kind]').forEach(card=>card.hidden=button.dataset.filter!=='all'&&card.dataset.kind!==button.dataset.filter);}));});
</script>
