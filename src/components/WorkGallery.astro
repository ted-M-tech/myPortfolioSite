---
import {openWorks as c} from '../data/profile';
const {compact=false}=Astro.props;
---
<div class:list={['artifact-gallery',{'is-compact':compact}]} data-gallery>
 <div class="gallery-toolbar"><div class="gallery-filters" aria-label="Works"><button data-filter="all" aria-pressed="true"><span class="ja">{c.all.ja}</span><span class="en">{c.all.en}</span><span class="count">{c.items.length}</span></button><button data-filter="LP" aria-pressed="false"><span class="ja">{c.lp.ja}</span><span class="en">{c.lp.en}</span><span class="count">{c.items.filter(x=>x.kind==='LP').length}</span></button><button data-filter="FILM" aria-pressed="false"><span class="ja">{c.film.ja}</span><span class="en">{c.film.en}</span><span class="count">{c.items.filter(x=>x.kind==='FILM').length}</span></button></div><span class="coming"><span class="ja">{c.future.ja}</span><span class="en">{c.future.en}</span></span></div>
 <div class="artifact-grid">{c.items.map(item=><article class="artifact" data-kind={item.kind}><a class="artifact-preview" href={item.href}><img src={item.image} alt={item.title.ja} width="960" height="600" loading="lazy"/><span class="preview-action"><span class="ja">{c.view.ja}</span><span class="en">{c.view.en}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a><div class="artifact-meta"><span>{item.kind}</span><span>{item.tags.join(' / ')}</span></div><h3><a href={item.href}><span class="ja">{item.title.ja}</span><span class="en">{item.title.en}</span></a></h3><p><span class="ja">{item.description.ja}</span><span class="en">{item.description.en}</span></p></article>)}</div>
</div>
<style>
.gallery-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line-strong);padding-bottom:20px;margin-bottom:30px}.gallery-filters{display:flex;gap:8px;flex-wrap:wrap}.gallery-filters button{display:flex;align-items:center;gap:9px;padding:9px 15px;border:1px solid transparent;border-radius:8px;background:none;color:var(--text-muted);font:inherit;font-size:13px;cursor:pointer}.gallery-filters button[aria-pressed=true]{background:var(--ink);color:var(--paper)}.count{font-size:11px;opacity:.75}.coming{font-size:12px;color:var(--text-muted)}.artifact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 26px}.artifact{min-width:0}.artifact[hidden]{display:none}.artifact-preview{display:block;position:relative;border-radius:12px;overflow:hidden;aspect-ratio:8/5;background:var(--surface-sunken);border:1px solid var(--line)}.artifact-preview img{width:100%;height:100%;object-fit:cover;object-position:top;display:block;transition:transform .45s var(--ease-out)}.preview-action{position:absolute;bottom:14px;right:14px;display:flex;align-items:center;gap:14px;background:var(--paper);color:var(--ink);padding:9px 12px;font-size:12px;border-radius:6px;opacity:0;transform:translateY(6px);transition:opacity .2s,transform .2s}.preview-action svg{width:16px;height:16px}.artifact-preview:hover img{transform:scale(1.025)}.artifact-preview:hover .preview-action,.artifact-preview:focus-visible .preview-action{opacity:1;transform:none}.artifact-meta{display:flex;justify-content:space-between;gap:12px;font-size:11px;color:var(--text-muted);margin:17px 0 9px}.artifact-meta>span:first-child{color:var(--text);font-weight:600}.artifact h3{font-size:clamp(18px,1.55vw,24px);line-height:1.55;letter-spacing:-.025em;font-weight:550;text-wrap:balance}.artifact p{font-size:13px;line-height:1.8;color:var(--text-muted);margin-top:9px}.artifact a:focus-visible,.gallery-filters button:focus-visible{outline:2px solid var(--accent);outline-offset:5px}@media(max-width:1100px){.artifact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.coming{display:none}}@media(max-width:620px){.artifact-grid{grid-template-columns:1fr;gap:34px}.gallery-toolbar{margin-bottom:24px}.gallery-filters{gap:3px}.gallery-filters button{padding:8px 12px}.preview-action{opacity:1;transform:none}.artifact-meta{font-size:11px}.artifact h3{font-size:21px}}@media(prefers-reduced-motion:reduce){.artifact-preview img,.preview-action{transition:none}}
</style>
<script>
document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(gallery=>{gallery.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{gallery.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));gallery.querySelectorAll<HTMLElement>('[data-kind]').forEach(card=>card.hidden=button.dataset.filter!=='all'&&card.dataset.kind!==button.dataset.filter);}));});
</script>
