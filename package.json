{
  "name": "maepace-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:sites": "pnpm build && node scripts/prepare-sites.mjs",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "test:payments": "node --test tests/payments.test.mjs",
    "dev:payments": "wrangler dev --port 8787",
    "stripe:setup-mentoring": "node scripts/setup-mentoring-stripe.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check:i18n": "python3 scripts/check-i18n.py"
  },
  "dependencies": {
    "astro": "^7.1.1",
    "fast-xml-parser": "^5.11.1",
    "parse5": "^7.3.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.7.3",
    "wrangler": "^4.112.0"
  }
}
